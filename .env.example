# Private TURN for cross-network online play (report 3 §1.1 #4).
# The game ships with free Open Relay credentials as a fallback, but they
# are shared/public and can be slow or cut off — provision your own
# coturn / Twilio / Cloudflare TURN for production and set these.
VITE_TURN_URLS=turn:your-turn-host:3478
VITE_TURN_USERNAME=your-username
VITE_TURN_CREDENTIAL=your-credential

# Wall debug overlay: load the game with ?debugWalls=1 to render the
# precomputed road-edge wall segments as yellow lines (report 3 §5 #7).
